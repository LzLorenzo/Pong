# Copie para .env.local (somente para `vercel dev`) — na Vercel configure em Settings → Environment Variables.
ADMIN_PASSWORD=troque-esta-senha
# Opcional: segredo separado para assinar a sessão do admin (padrão = ADMIN_PASSWORD)
# AUTH_SECRET=
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel
# BLOB_READ_WRITE_TOKEN=
